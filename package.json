{
  "name": "enterprise-medusa-nextjs-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade, zero-vulnerability Headless E-commerce platform with Medusa v2, Next.js 15, PostgreSQL, Redis, and RTL/LTR support",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "npm run build --workspace=@enterprise/schemas && npm run build --workspace=@enterprise/backend && npm run build --workspace=@enterprise/storefront",
    "lint": "npm run typecheck",
    "clean": "npm run clean --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/regression.test.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "test:ui": "node tests/ui-operational.cjs"
  },
  "keywords": [
    "medusa-v2",
    "nextjs-15",
    "ecommerce",
    "arabic-rtl",
    "headless",
    "postgresql",
    "redis"
  ],
  "author": "Principal Full-Stack Architect",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "^4.6.7",
    "lodash": "^4.18.1",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "ajv@>=7": "^8.18.0",
    "bullmq": {
      "uuid": "^11.1.1"
    },
    "@graphql-tools/utils": "^13.1.3"
  }
}
